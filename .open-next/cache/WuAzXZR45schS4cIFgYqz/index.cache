{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/"}},"html":"<!DOCTYPE html><!--WuAzXZR45schS4cIFgYqz--><html lang=\"en\" class=\"font-sans __variable_4589d5 __variable_9eb1c4\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/569ce4b8f30dc480-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/93f479601ee12b01-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/css/5ce7081c8e024bbe.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-db984efe6aa656ce.js\"/><script src=\"/_next/static/chunks/8fd2a1ab-4d802cff1ffd8112.js\" async=\"\"></script><script src=\"/_next/static/chunks/31952-87a5d17323669366.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-d7ce1a3c34b9d480.js\" async=\"\"></script><script src=\"/_next/static/chunks/97532-1ea0c4d234ddf688.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-55215d9ff01a096a.js\" async=\"\"></script><script src=\"/_next/static/chunks/5235-3370de808ca151d9.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/page-d35d9999fbc5e154.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>AI for Your App&#x27;s Data and Workflows | RJLS Systems</title><meta name=\"description\" content=\"Add a focused AI capability to an existing application, connected only to the data, tools, and actions approved for the workflow.\"/><meta property=\"og:title\" content=\"AI for Your App&#x27;s Data and Workflows | RJLS Systems\"/><meta property=\"og:description\" content=\"Add a useful AI interface to an existing application or service, with access and actions scoped to the workflow.\"/><meta property=\"og:image:alt\" content=\"RJLS Systems builds AI that works with existing products&#x27; data and workflows.\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image\" content=\"https://rjlssystems.com/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"AI for Your App&#x27;s Data and Workflows | RJLS Systems\"/><meta name=\"twitter:description\" content=\"Add a useful AI interface to an existing application or service, with access and actions scoped to the workflow.\"/><meta name=\"twitter:image\" content=\"https://rjlssystems.com/og.png\"/><link rel=\"icon\" href=\"/icon.png?40f83fcdd6e27089\" type=\"image/png\" sizes=\"200x200\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><div class=\"dark min-h-[100dvh] bg-cream dark:bg-night\"><a class=\"fixed left-4 top-4 z-50 -translate-y-24 rounded-md bg-forest px-4 py-2 text-sm font-semibold text-cream transition-transform hover:bg-navy focus:translate-y-0 dark:bg-forest dark:text-cream dark:hover:bg-mist dark:hover:text-navy\" href=\"#main-content\">Skip to content</a><nav aria-label=\"Primary navigation\" class=\"sticky top-0 z-40 border-b border-forest/10 bg-cream dark:border-cream/20 dark:bg-night\"><div class=\"mx-auto flex h-[4.5rem] max-w-7xl items-center justify-between gap-6 px-6 lg:px-10\"><a class=\"group inline-flex min-w-0 items-center gap-3 rounded-md font-semibold text-navy focus-visible:outline-none dark:text-cream\" href=\"/\"><span class=\"grid size-10 flex-none place-items-center rounded-md bg-forest font-mono text-xs text-cream transition-transform duration-200 group-hover:-translate-y-0.5 group-active:translate-y-px dark:bg-forest dark:text-cream\">RJ</span><span class=\"truncate tracking-[-0.02em]\">RJLS Systems</span></a><div class=\"hidden items-center gap-1 md:flex\"><a class=\"rounded-md px-3 py-2 text-sm font-medium transition duration-200 active:translate-y-px text-forest hover:bg-forest/5 hover:text-navy dark:text-sage dark:hover:bg-cream/[0.12] dark:hover:text-cream\" href=\"/our-process\">Our Process</a><a class=\"rounded-md px-3 py-2 text-sm font-medium transition duration-200 active:translate-y-px text-forest hover:bg-forest/5 hover:text-navy dark:text-sage dark:hover:bg-cream/[0.12] dark:hover:text-cream\" href=\"/contact\">Contact</a></div><div class=\"flex items-center gap-2\"><button aria-label=\"Switch to light mode\" class=\"group grid size-10 place-items-center rounded-md border border-forest/10 text-navy transition duration-200 hover:bg-forest/5 active:translate-y-px dark:border-cream/20 dark:text-sage dark:hover:bg-cream/[0.12]\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sun size-4 transition-transform group-hover:rotate-12\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2\"></path><path d=\"M12 20v2\"></path><path d=\"m4.93 4.93 1.41 1.41\"></path><path d=\"m17.66 17.66 1.41 1.41\"></path><path d=\"M2 12h2\"></path><path d=\"M20 12h2\"></path><path d=\"m6.34 17.66-1.41 1.41\"></path><path d=\"m19.07 4.93-1.41 1.41\"></path></svg></button><button aria-controls=\"mobile-menu\" aria-expanded=\"false\" aria-label=\"Open main menu\" class=\"grid size-10 place-items-center rounded-md border border-forest/10 text-navy transition hover:bg-forest/5 active:translate-y-px md:hidden dark:border-cream/20 dark:text-sage dark:hover:bg-cream/[0.12]\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu size-5\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></div></nav><main class=\"min-h-screen overflow-hidden bg-cream dark:bg-night\" id=\"main-content\"><section class=\"relative\"><div aria-hidden=\"true\" class=\"page-grid absolute inset-0 opacity-35 dark:opacity-20\"></div><div class=\"relative mx-auto grid min-h-[calc(100dvh-4.5rem)] w-full max-w-7xl items-center gap-10 px-6 py-10 lg:grid-cols-[0.82fr_1.18fr] lg:px-10 lg:py-12\"><div class=\"max-w-xl\"><p class=\"mb-5 font-mono text-xs font-medium uppercase tracking-[0.18em] text-forest dark:text-mint\">AI for an existing product or service</p><h1 class=\"text-5xl font-semibold leading-[0.98] tracking-[-0.055em] md:text-6xl text-navy dark:text-cream\">Add a useful AI interface to the product people already use.</h1><p class=\"mt-6 max-w-[52ch] text-lg leading-8 text-forest dark:text-sage\">We help small product companies add AI that works with their app&#x27;s data and workflows, so customers or employees can find relevant information and prepare or complete permitted actions.</p><div class=\"mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center\"><a class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md bg-forest px-5 py-3 text-sm font-semibold text-cream transition duration-200 hover:-translate-y-0.5 hover:bg-navy active:translate-y-px dark:bg-forest dark:text-cream dark:hover:bg-mist dark:hover:text-navy\" href=\"mailto:lukasasorensen@gmail.com?subject=RJLS Systems AI integration inquiry\">Request an exploratory call<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right size-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"inline-flex items-center gap-2 rounded-md py-2 text-sm font-semibold underline decoration-sage-muted underline-offset-4 transition hover:text-forest active:translate-y-px dark:decoration-sage-muted dark:hover:text-mint text-navy dark:text-cream\" href=\"#ai-assistant\">Try the example assistant</a></div></div><div class=\"min-w-0 scroll-mt-24\" id=\"ai-assistant\"><div class=\"mb-3 flex items-center justify-between gap-4 px-1\"><p class=\"font-mono text-xs text-forest dark:text-sage\">Live, tool-using product demo</p><p class=\"hidden text-xs sm:block text-forest dark:text-sage\">Ask about RJLS or try a prompt</p></div><!--$!--><template data-dgst=\"BAILOUT_TO_CLIENT_SIDE_RENDERING\"></template><!--/$--></div></div></section><section class=\"border-y border-forest/10 bg-mist/70 px-6 py-10 lg:px-10 dark:border-cream/20 dark:bg-night-surface/70\"><div class=\"mx-auto grid max-w-7xl gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-4\"><div class=\"flex items-start gap-3\"><span class=\"mt-1 grid size-5 flex-none place-items-center rounded bg-forest text-cream dark:bg-forest dark:text-cream\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check size-3\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg></span><p class=\"text-sm leading-6 text-forest dark:text-sage\">Let users find the right document or record without learning another search system.</p></div><div class=\"flex items-start gap-3\"><span class=\"mt-1 grid size-5 flex-none place-items-center rounded bg-forest text-cream dark:bg-forest dark:text-cream\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check size-3\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg></span><p class=\"text-sm leading-6 text-forest dark:text-sage\">Turn a conversation into an approved update through your existing APIs.</p></div><div class=\"flex items-start gap-3\"><span class=\"mt-1 grid size-5 flex-none place-items-center rounded bg-forest text-cream dark:bg-forest dark:text-cream\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check size-3\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg></span><p class=\"text-sm leading-6 text-forest dark:text-sage\">Use the identity and permissions your application already relies on.</p></div><div class=\"flex items-start gap-3\"><span class=\"mt-1 grid size-5 flex-none place-items-center rounded bg-forest text-cream dark:bg-forest dark:text-cream\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check size-3\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg></span><p class=\"text-sm leading-6 text-forest dark:text-sage\">Keep sensitive data, available actions, and business rules under your control.</p></div></div></section><section class=\"px-6 py-20 lg:px-10 lg:py-28\"><div class=\"mx-auto grid max-w-7xl items-stretch gap-10 lg:grid-cols-[0.88fr_1.12fr]\"><div class=\"relative min-h-[24rem] overflow-hidden rounded-xl bg-mist lg:min-h-[40rem] dark:bg-night-surface\"><img alt=\"Organized connections between an AI interface and approved business systems\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"dark:contrast-110 object-cover grayscale-[0.3] dark:brightness-75\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(min-width: 1024px) 42vw, 100vw\" srcSet=\"/_next/image?url=%2Frjls-systems-connections.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Frjls-systems-connections.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Frjls-systems-connections.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Frjls-systems-connections.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Frjls-systems-connections.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Frjls-systems-connections.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Frjls-systems-connections.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Frjls-systems-connections.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Frjls-systems-connections.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Frjls-systems-connections.png&amp;w=3840&amp;q=75\"/><div aria-hidden=\"true\" class=\"absolute inset-0 bg-[radial-gradient(circle_at_75%_20%,transparent_0%,rgba(35,61,77,0.20)_100%)]\"></div></div><div class=\"flex flex-col justify-center lg:pl-8\"><h2 class=\"max-w-2xl text-4xl font-semibold tracking-[-0.04em] md:text-5xl text-navy dark:text-cream\">One conversation, grounded in your product and workflow.</h2><p class=\"mt-5 max-w-[62ch] text-lg leading-8 text-forest dark:text-sage\">The assistant uses only the approved data, tools, and actions needed for the job. Existing identity, permissions, validation, and business rules remain in charge.</p><div class=\"mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2\"><article class=\"border-t border-forest/15 pt-5 dark:border-cream/25\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-message-square-text size-5 text-forest dark:text-mint\" aria-hidden=\"true\"><path d=\"M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z\"></path><path d=\"M7 11h10\"></path><path d=\"M7 15h6\"></path><path d=\"M7 7h8\"></path></svg><h3 class=\"mt-4 text-lg font-semibold tracking-[-0.02em] text-navy dark:text-cream\">A user asks</h3><p class=\"mt-2 text-sm leading-6 text-forest dark:text-sage\">A customer or employee describes what they need in everyday language.</p></article><article class=\"border-t border-forest/15 pt-5 dark:border-cream/25\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-plug-zap size-5 text-forest dark:text-mint\" aria-hidden=\"true\"><path d=\"M6.3 20.3a2.4 2.4 0 0 0 3.4 0L12 18l-6-6-2.3 2.3a2.4 2.4 0 0 0 0 3.4Z\"></path><path d=\"m2 22 3-3\"></path><path d=\"M7.5 13.5 10 11\"></path><path d=\"M10.5 16.5 13 14\"></path><path d=\"m18 3-4 4h6l-4 4\"></path></svg><h3 class=\"mt-4 text-lg font-semibold tracking-[-0.02em] text-navy dark:text-cream\">The AI understands</h3><p class=\"mt-2 text-sm leading-6 text-forest dark:text-sage\">The assistant understands your business domain and customer&#x27;s needs.</p></article><article class=\"border-t border-forest/15 pt-5 dark:border-cream/25\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-database size-5 text-forest dark:text-mint\" aria-hidden=\"true\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"></ellipse><path d=\"M3 5V19A9 3 0 0 0 21 19V5\"></path><path d=\"M3 12A9 3 0 0 0 21 12\"></path></svg><h3 class=\"mt-4 text-lg font-semibold tracking-[-0.02em] text-navy dark:text-cream\">Your systems respond</h3><p class=\"mt-2 text-sm leading-6 text-forest dark:text-sage\">The integration uses approved APIs while honoring existing authentication, permissions, and business rules.</p></article><article class=\"border-t border-forest/15 pt-5 dark:border-cream/25\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-fingerprint-pattern size-5 text-forest dark:text-mint\" aria-hidden=\"true\"><path d=\"M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4\"></path><path d=\"M14 13.12c0 2.38 0 6.38-1 8.88\"></path><path d=\"M17.29 21.02c.12-.6.43-2.3.5-3.02\"></path><path d=\"M2 12a10 10 0 0 1 18-6\"></path><path d=\"M2 16h.01\"></path><path d=\"M21.8 16c.2-2 .131-5.354 0-6\"></path><path d=\"M5 19.5C5.5 18 6 15 6 12a6 6 0 0 1 .34-2\"></path><path d=\"M8.65 22c.21-.66.45-1.32.57-2\"></path><path d=\"M9 6.8a6 6 0 0 1 9 5.2v2\"></path></svg><h3 class=\"mt-4 text-lg font-semibold tracking-[-0.02em] text-navy dark:text-cream\">The result stays controlled</h3><p class=\"mt-2 text-sm leading-6 text-forest dark:text-sage\">The user receives an answer, reviews an update, and guardrails keep the AI from accessing sensitive information.</p></article></div></div></div></section><section class=\"border-y border-forest/10 bg-mist/65 px-6 py-20 lg:px-10 lg:py-28 dark:border-cream/20 dark:bg-night-surface/65\"><div class=\"mx-auto grid max-w-7xl gap-12 lg:grid-cols-[1.1fr_0.9fr]\"><div><h2 class=\"max-w-2xl text-4xl font-semibold tracking-[-0.04em] md:text-5xl text-navy dark:text-cream\">Let AI Take Action</h2><div class=\"mt-12 grid gap-8 md:grid-cols-2\"><article class=\"md:col-span-2 md:max-w-2xl\"><h3 class=\"text-xl font-semibold tracking-[-0.025em] text-navy dark:text-cream\">AI inside your product</h3><p class=\"mt-3 leading-7 text-forest dark:text-sage\">AI can interact with your app or business data with secure guardrails. Allow AI to understand your product and interact with it.</p></article><article><h3 class=\"text-xl font-semibold tracking-[-0.025em] text-navy dark:text-cream\">Internal knowledge and operations</h3><p class=\"mt-3 leading-7 text-forest dark:text-sage\">Give teams a simpler way to search business records, prepare work, and update internal systems with fewer manual steps.</p></article><article><h3 class=\"text-xl font-semibold tracking-[-0.025em] text-navy dark:text-cream\">Customer self-service</h3><p class=\"mt-3 leading-7 text-forest dark:text-sage\">Help customers find account information, understand documents, and complete approved changes from one conversation.</p></article></div></div><aside class=\"self-start rounded-xl bg-cream p-7 md:p-9 dark:bg-night\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-key-round size-6 text-forest dark:text-mint\" aria-hidden=\"true\"><path d=\"M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z\"></path><circle cx=\"16.5\" cy=\"7.5\" r=\".5\" fill=\"currentColor\"></circle></svg><h2 class=\"mt-6 text-3xl font-semibold tracking-[-0.035em] text-navy dark:text-cream\">Clear boundaries for every connection.</h2><p class=\"mt-4 leading-7 text-forest dark:text-sage\">You approve what the assistant can access and do. Sensitive changes can stay behind validation, review, or explicit confirmation.</p><div class=\"mt-8 space-y-5\"><div class=\"flex gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check mt-1 size-4 flex-none text-forest dark:text-mint\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><p class=\"text-sm leading-6 text-forest dark:text-sage\">Existing authentication and permissions remain the source of truth.</p></div><div class=\"flex gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check mt-1 size-4 flex-none text-forest dark:text-mint\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><p class=\"text-sm leading-6 text-forest dark:text-sage\">AI can access only the tools, data, and actions approved for the workflow.</p></div><div class=\"flex gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check mt-1 size-4 flex-none text-forest dark:text-mint\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><p class=\"text-sm leading-6 text-forest dark:text-sage\">Sensitive updates can require validation, review, or explicit confirmation.</p></div><div class=\"flex gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check mt-1 size-4 flex-none text-forest dark:text-mint\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><p class=\"text-sm leading-6 text-forest dark:text-sage\">Requests, actions, failures, and costs can be logged and observed within the agreed integration scope.</p></div></div></aside></div></section><section class=\"border-t border-forest/10 px-6 py-16 lg:px-10 lg:py-20 dark:border-cream/20\"><div class=\"mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 md:flex-row md:items-center\"><h2 class=\"max-w-3xl text-3xl font-semibold tracking-[-0.035em] md:text-4xl text-navy dark:text-cream\">Have an existing workflow where AI could be genuinely useful?</h2><a class=\"inline-flex flex-none items-center justify-center gap-2 whitespace-nowrap rounded-md bg-forest px-5 py-3 text-sm font-semibold text-cream transition duration-200 hover:-translate-y-0.5 hover:bg-navy active:translate-y-px dark:bg-forest dark:text-cream dark:hover:bg-mist dark:hover:text-navy\" href=\"mailto:lukasasorensen@gmail.com?subject=RJLS Systems AI integration inquiry\">Request an exploratory call<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right size-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></section></main><!--$--><!--/$--><footer class=\"border-t border-forest/10 bg-cream px-6 py-10 lg:px-10 dark:border-cream/20 dark:bg-night\"><div class=\"mx-auto grid max-w-7xl gap-8 md:grid-cols-[1fr_auto] md:items-end\"><div><a class=\"inline-flex items-center gap-3 font-semibold text-navy dark:text-cream\" href=\"/\"><span class=\"grid size-9 place-items-center rounded-md bg-forest font-mono text-xs text-cream dark:bg-forest dark:text-cream\">RJ</span>RJLS Systems</a><p class=\"mt-4 max-w-md text-sm leading-6 text-forest dark:text-sage\">Add AI that works with your app&#x27;s data and workflows, with access and actions scoped to the job.</p><a class=\"mt-4 inline-flex text-sm font-semibold text-forest underline decoration-forest/40 underline-offset-4 transition-colors hover:text-night dark:text-mint dark:hover:text-mist\" href=\"mailto:lukasasorensen@gmail.com?subject=RJLS Systems AI integration inquiry\">Start an exploratory conversation</a><p class=\"mt-6 font-mono text-xs text-forest-soft dark:text-sage\">© <!-- -->2026<!-- --> <!-- -->RJLS Systems</p></div><nav aria-label=\"Footer navigation\" class=\"flex flex-wrap gap-x-6 gap-y-3\"><a class=\"text-sm font-medium text-forest transition-colors hover:text-forest active:translate-y-px dark:text-sage dark:hover:text-mint\" href=\"/our-process\">Our Process</a><a class=\"text-sm font-medi