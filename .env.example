# OpenAI credentials (required for the /chat feature)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override the model (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: enable LangSmith observability for the LangChain /api/chat agent
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=theory-foundry-marketing-ai
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
